# -------------------------------------------------------
# Réviz — Build iOS (Capacitor) : `vite build --mode ios`
# Ce fichier a priorité sur .env.local (fichiers de mode Vite).
# -------------------------------------------------------

# L'app native appelle l'API Vercel en URL absolue (via CapacitorHttp).
VITE_API_BASE=https://reviz-gamma.vercel.app

# Neutralise la clé dev de .env.local : le bundle iOS ne doit JAMAIS
# embarquer la clé Anthropic — mode proxy forcé (voir USE_PROXY).
VITE_ANTHROPIC_API_KEY=REMPLACER

# Boutons de connexion en plus de Google. Apple est obligatoire sur l'App
# Store (règle 4.8) dès que Google est proposé. TikTok n'est pas proposé
# dans l'app iOS.
VITE_AUTH_PROVIDERS=apple
